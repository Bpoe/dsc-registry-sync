<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Package</OutputType>
    <OutputName>dscregsyncd-$(ProductVersion)-windows-amd64</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);BinaryPath=$(BinaryPath)</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Go PE version supplied by MSI; recovery flag is verified on install. -->
    <SuppressSpecificWarnings>1103;1149</SuppressSpecificWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
